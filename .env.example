PORT=4000
NODE_ENV=development

# ----------------------------------------------------
# 🐘 BANCO DE DADOS POSTGRESQL (NEON DATABASE)
# https://neon.tech
# ----------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:SENHA_DO_SEU_NEON@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:SENHA_DO_SEU_NEON@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------
# ✉️ SERVIÇO DE E-MAILS & NOTIFICAÇÕES (MAILTRAP.IO)
# https://mailtrap.io
# ----------------------------------------------------
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="SEU_USUARIO_MAILTRAP"
SMTP_PASS="SUA_SENHA_MAILTRAP"
SMTP_FROM="SorteioHub <nao-responda@sorteiohub.com.br>"

# ----------------------------------------------------
# 🔐 AUTENTICAÇÃO JWT & SESSÕES SEGURAS
# ----------------------------------------------------
JWT_SECRET="super-secret-jwt-key-sorteiohub-production-grade-2026"
JWT_EXPIRES_IN="7d"

# ----------------------------------------------------
# 🛡️ PROTEÇÃO DE DADOS & LGPD (CPF CRIPTOGRAFADO)
# ----------------------------------------------------
CPF_HMAC_SECRET="secret-hmac-cpf-key-super-secure"
CPF_ENCRYPTION_KEY="01234567890123456789012345678901"

# ----------------------------------------------------
# 🔑 GOOGLE OAUTH 2.0
# ----------------------------------------------------
GOOGLE_CLIENT_ID="mock-or-real-google-client-id"
GOOGLE_CLIENT_SECRET="mock-or-real-google-secret"

# ----------------------------------------------------
# 🌐 URL DO FRONTEND (CORS)
# Aceita URLs únicas ou múltiplas separadas por vírgula (ex: "http://localhost:5173,http://localhost:3000,https://meudominio.com")
# ----------------------------------------------------
FRONTEND_URL="http://localhost:5173"
